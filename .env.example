# ==========================================================
# RYDE Platform Environment Variables
# Copy this file to .env.local and replace the placeholders
# with your own values.
# Never commit .env.local to GitHub.
# ==========================================================

# ===========================
# Application
# ===========================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================
# Supabase
# ===========================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================
# Stripe
# ===========================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================
# Resend
# ===========================

RESEND_API_KEY=

# ===========================
# Google Maps
# ===========================

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ===========================
# Admin dashboard (admin.html)
# ===========================

# Shared password for /admin.html. Pick something long and random -
# this is the only thing standing between the internet and your
# customer list/revenue numbers.
ADMIN_PASSWORD=

# Optional. If unset, the session-signing secret is derived from
# ADMIN_PASSWORD + SUPABASE_SERVICE_ROLE_KEY, so admin login still
# works without this - but setting your own long random value here
# is recommended for production.
ADMIN_SESSION_SECRET=